            "request": "launch",
            "name": "radio_service",
            "cargo": {
                "args": ["build", "--bin", "radio_service", "-F", "test"],
                "filter": {
                    "kind": "bin",
                    "name": "radio_service"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "radio_gui",
            "cargo": {
                "args": ["build", "--bin", "radio_gui", "-F", "test"],
                "filter": {
                    "kind": "bin",
                    "name": "radio_gui"
