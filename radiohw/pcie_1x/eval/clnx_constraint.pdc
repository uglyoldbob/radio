create_clock -name {refclkp_i} -period 10 [get_ports refclkp_i]
create_clock -name {clk_usr_i} -period 4 [get_ports clk_usr_i]
create_clock -name {usr_lmmi_clk_i} -period 4 [get_ports usr_lmmi_clk_i]
##CDC constraint
#set_clock_groups -group [get_clocks refclkp_i] -group [get_clocks usr_lmmi_clk_i] -asynchronous
#set_clock_groups -group [get_clocks clk_usr_i] -group [get_clocks usr_lmmi_clk_i] -asynchronous
set_clock_groups -group [get_clocks refclkp_i] -group [get_clocks clk_usr_i] -asynchronous
#
